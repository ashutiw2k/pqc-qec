   119                                           @profile
   120                                           def simple_circuit_generator(circuit_ops, num_qubits, x_noise, z_noise):
   121                                               """
   122                                               Generates a PennyLane QNode for a given quantum circuit.
   123                                               This function is decorated for line-profiling.
   124                                               """
   125                                               qdevice = qml.device("default.qubit", wires=num_qubits)
   126                                           
   127                                               @qml.qnode(qdevice)
   128                                               def circuit(state):
   129                                                   qml.StatePrep(state, wires=range(num_qubits), normalize=True)
   130                                                   for i, op in enumerate(circuit_ops):
   131                                                       gate, wires, param = op
   132                                                       PENNYLANE_GATES[gate](wires=wires) # Assuming param is not used if None
   133                                                       for wire in wires:
   134                                                           qml.RX(x_noise[i], wires=[wire])
   135                                                           qml.RZ(z_noise[i], wires=[wire])
   136                                                   return qml.state()
   137                                           
   138                                               return circuit

